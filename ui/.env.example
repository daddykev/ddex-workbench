# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration
# Optional. Base URL for src/services/api.js. Leave empty for the defaults:
# the emulator in `npm run dev`, https://api.ddex-workbench.org/v1 in builds.
# Emulator: VITE_API_BASE_URL=http://127.0.0.1:5001/ddex-workbench/us-central1/app
VITE_API_BASE_URL=
